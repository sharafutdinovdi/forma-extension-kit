{
  "name": "forma-extension-kit",
  "version": "0.1.0",
  "description": "Read-only host adapters for Autodesk Forma embedded extensions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "tsc",
    "prepack": "npm run build"
  },
  "peerDependencies": { "forma-embedded-view-sdk": ">=0.96 <1" },
  "devDependencies": {
    "forma-embedded-view-sdk": "0.96.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharafutdinovdi/forma-extension-kit.git"
  },
  "bugs": { "url": "https://github.com/sharafutdinovdi/forma-extension-kit/issues" },
  "homepage": "https://github.com/sharafutdinovdi/forma-extension-kit#readme",
  "author": "Dinar Sharafutdinov",
  "license": "MIT",
  "keywords": ["autodesk", "forma", "extensions", "typescript"]
}
